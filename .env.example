# Copy to `.env.local` at repo root OR `apps/web/.env.local` (either works after restart).
# Microsoft Entra ID — required for Autopilot (/autopilot)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use `common` for personal @outlook.com + work/school. A tenant GUID limits who can sign in.
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string-min-16-chars

CURRENT_FISCAL_YEAR=2026
REFERENCE_DATE=2026-09-01

# Autopilot demo thank-you — recreated on each inbox load after send (set to "off" to disable)
# DEMO_THANK_YOU_EMAIL=avalatoria0913@gmail.com

# Dev/demo: skip live Graph calendar; use saved calendar-cache.json (shifted to planning week)
# TUESDAY_DEMO_OUTLOOK=1
