{
  "name": "tuesday",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "@tuesday/core": "*"
  },
  "scripts": {
    "ingest": "tsx scripts/ingest.ts",
    "inspect:data": "tsx scripts/inspect-dataset.ts",
