    "start": "npm run start -w @tuesday/web"
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "csv-parse": "^5.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
